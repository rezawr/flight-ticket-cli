{
  "name": "flight-ticket-cli",
  "version": "0.1.2",
  "description": "CLI-only flight fare aggregator for tiket.com, Traveloka, and Agoda using CloakBrowser",
  "author": "rezawr",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezawr/flight-ticket-cli.git"
  },
  "homepage": "https://github.com/rezawr/flight-ticket-cli#readme",
  "bugs": {
    "url": "https://github.com/rezawr/flight-ticket-cli/issues"
  },
  "bin": {
    "flight-ticket-pp-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cloakbrowser": "^0.3.28",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
